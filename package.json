{
  "name": "super-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Router–Worker 双层个人 Agent 系统",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local src/main.ts",
    "watchdog": "node --env-file-if-exists=.env.local src/watchdog/main.ts",
    "dev": "node --env-file-if-exists=.env.local --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "smoke:mini": "node --env-file-if-exists=.env.local scripts/smoke-mini.ts",
    "smoke:real": "node --env-file-if-exists=.env.local scripts/smoke-real.ts",
    "smoke:toolkit": "node --env-file-if-exists=.env.local scripts/smoke-toolkit.ts",
    "format": "prettier --write .",
    "channel:weixin-login": "node --env-file-if-exists=.env.local scripts/weixin-login.ts",
    "channel:status": "node --env-file-if-exists=.env.local scripts/channel-status.ts",
    "accept:channel": "node scripts/accept-channel.ts",
    "channel:doctor": "node --env-file-if-exists=.env.local scripts/channel-doctor.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.1"
  }
}
