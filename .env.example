# ============================================================
# 模块 1（Router–Worker 双层骨架）配置
# 复制为 .env.local 并填写；.env.local 已被 .gitignore 忽略
# ============================================================

# ---- 模型（OpenAI 兼容端点）----
MODEL_PROVIDER=ollama-cloud
MODEL_NAME=deepseek-v4.1-flash
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=

# 思考强度：low | medium | high | max（透传给提供方的 reasoning_effort）
MODEL_REASONING_EFFORT=max
# 请求超时（毫秒）
MODEL_TIMEOUT_MS=180000
# 单次回复的输出上限（含思考过程）
MODEL_MAX_TOKENS=16384
# 同时发往提供方的模型请求上限（Ollama 云端在超并发时会返回 finish_reason=load）
MODEL_CONCURRENCY=2

# Router 与 Worker 可分别指定模型；留空则继承 MODEL_NAME
ROUTER_MODEL=
WORKER_MODEL=

# ---- 存储 ----
# SQLite 数据库文件；相对路径基于仓库根目录
DB_PATH=.data/agent.db
# 产物与工作目录根
WORK_DIR=work

# ---- 资源限制（统一在此调整）----
MAX_CONCURRENT_RUNS=3
MAX_WORKERS_PER_GROUP=6
MAX_TOTAL_WORKERS=12

# 上下文与工作记录（单位都是字符数，不是 token）
# Worker 近期历史的字符预算（≈ token × 4）。
CONTEXT_WINDOW_CHARS=200000
CONTEXT_PAIRING_OVERSHOOT_CHARS=8000
# Router 会话历史的 token 预算（与上一项口径不同：这一项按 token 算）。
# 压缩阈值 = min(窗口 - 预留, 窗口 × 0.75)，超出就把旧对话压成摘要。
CONTEXT_WINDOW_TOKENS=200000
ROUTER_RESERVE_TOKENS=16384
ROUTER_KEEP_RECENT_TOKENS=40000
ROUTER_NOTE_MAX_CHARS=6000
NOTE_TRIGGER_TURNS=10
NOTE_TRIGGER_CHARS=3000
NOTE_MAX_CHARS=6000
NOTE_INPUT_CHARS=24000
NOTE_RETRY_MS=120000
NOTE_MAX_FAILURES=3

# 累计调用软阈值：>0 时只记录预算事件，不再让 Worker / 群组失败（0 = 不提醒）。
# Router 单次运行的调度轮数；用完保存进度，下次 tick 自动继续。
MAX_ROUTER_ROUNDS=6
# Watchdog 巡检间隔与可选模型（默认复用 Worker 模型）。
WATCHDOG_INTERVAL_MS=60000
# WATCHDOG_MODEL=

# 联网搜索（可选）。不配置时 net_search 直接报错，net_fetch 仍然可用。
# SEARCH_API_URL=https://api.tavily.com/search
# SEARCH_API_KEY=
# 当前模型是否支持图片输入；不支持时保持为空，图片能力会被标记为不可用。
# MODEL_VISION=0
MAX_REQUEST_HOPS=4
MESSAGE_TTL_MINUTES=30
WAIT_TIMEOUT_SECONDS=300
MODEL_RETRY=2

# ============================================================
# 以下为上一代实现遗留配置，本模块未使用，保留备查
# ============================================================
# DATABASE_URL=postgres://super:replace-me@127.0.0.1:5432/super_agent
# MEMORY_KEY=replace-with-at-least-32-random-characters
# COST_BUDGET_USD=10
# HOST=127.0.0.1
# PORT=3000
# PGLITE_DIR=data/pglite
# SUPER_AGENT_PROJECT_ROOT=

# ---- 模型目录（可选）----
# 不配时，按 MODEL_NAME 自动生成一个 default 别名，旧配置照常启动。
# 别名只是名字，不绑定「规划者/执行者/检查者」职责；凭据只从环境读取，
# 写在目录里的 apiKey 会被忽略。
#
# 每个别名可以有自己的供应商、端点与凭据：apiKeyEnv 写「环境变量名」，
# 明文 key 仍然只放在 .env.local 里。不写 apiKeyEnv 则用全局 MODEL_API_KEY。
# reasoningEffort 逐别名生效：便宜的日常模型跑 max 只是白烧 token。
#
# 注意：node --env-file 不覆盖已存在的环境变量。如果 shell 里已有同名变量，
# 文件里的值会静默失效——取一个不冲突的名字（例如 PRO_API_KEY 而不是通用的 API_KEY）。
# MODEL_CATALOG=[{"alias":"default","model":"deepseek-v4.1-flash:1017-cloud","note":"日常执行与协作"},{"alias":"pro","provider":"congee","baseUrl":"https://invite.congee.pro/v1","apiKeyEnv":"PRO_API_KEY","model":"gpt-6.1-sol","reasoningEffort":"max","note":"规划、检查、疑难判断","costHint":"按 token 计费，高于默认模型"}]
# PRO_API_KEY=...
# DEFAULT_MODEL_ALIAS=default

# ---- 渠道（IM 接入）：不启用时保持原有 CLI 行为 ----
# 公共
CHANNEL_STATE_DIR=.data/channels
CHANNEL_POLL_TIMEOUT_MS=35000
CHANNEL_MAX_INBOUND_BYTES=26214400

# Telegram：长轮询，不需要公网入口
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
# 逗号分隔的数字 user id（不是 @username）
TELEGRAM_OWNER_IDS=
TELEGRAM_API_BASE=https://api.telegram.org

# 个人微信（腾讯 iLink）：凭据由 pnpm channel:weixin-login 扫码后写入 CHANNEL_STATE_DIR
WEIXIN_ENABLED=0
# 留空则使用扫码确认的 ilink_user_id
WEIXIN_OWNER_IDS=
WEIXIN_API_BASE=https://ilinkai.weixin.qq.com
WEIXIN_CDN_BASE=https://novac2c.cdn.weixin.qq.com/c2c
