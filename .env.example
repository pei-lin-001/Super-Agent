# Copy to .env; replace every value before production.
DATABASE_URL=postgres://super:replace-me@127.0.0.1:5432/super_agent
MEMORY_KEY=replace-with-at-least-32-random-characters
COST_BUDGET_USD=10
HOST=127.0.0.1
PORT=3000

# Local model provider (Ollama Cloud is OpenAI-compatible)
MODEL_PROVIDER=ollama-cloud
MODEL_NAME=deepseek-v4.1-flash
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4.1-flash
OLLAMA_API_KEY=
# 可选：各角色模型留空时继承 MODEL_NAME；仅在实际配置不同型号后才有模型分工。
ROUTER_MODEL=
WORKER_FAST_MODEL=
WORKER_DEEP_MODEL=
VERIFIER_MODEL=
PGLITE_DIR=data/pglite

# 可选：允许只读查看的本地项目绝对路径。留空时使用 Super-Agent 仓库根目录。
SUPER_AGENT_PROJECT_ROOT=
